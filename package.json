{
  "name": "vibeboard",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.mjs & vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "desktop": "vite build && electron desktop/main.cjs",
    "test": "node --test 'test/*.test.mjs' && node server/usage.mjs && node server/scan.mjs && node server/docs.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "lucide-react": "^1.61.0",
    "marked": "18.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
