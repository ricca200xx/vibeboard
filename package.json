{
  "name": "vibeboard",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.mjs & vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "desktop": "vite build && electron desktop/main.cjs",
    "test": "node --test 'test/*.test.mjs' && node server/usage.mjs && node server/scan.mjs && node server/docs.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "dist": "vite build && electron-builder --mac --arm64 --publish never && electron-builder --mac --x64 --publish never"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "lucide-react": "^1.61.0",
    "marked": "18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "description": "A board of real terminals for your coding agents, on your Mac.",
  "author": "Riccardo Niccolò Agosti",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "io.github.ricca200xx.vibeboard",
    "productName": "vibeboard",
    "copyright": "Copyright © 2026 Riccardo Niccolò Agosti",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "server/**",
      "shared/**",
      "dist/**",
      "package.json",
      "!node_modules/node-pty/prebuilds/win32*/**",
      "!node_modules/node-pty/third_party/**"
    ],
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null,
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "vibeboard listens only while you dictate a command."
      }
    },
    "dmg": {
      "title": "vibeboard ${version}"
    },
    "afterPack": "build/adhoc-sign.cjs"
  }
}
